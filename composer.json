{
    "name": "onemax-az/onemax",
    "description": "PHP client for the OneMax partner API: check a member and record a usage from your own system.",
    "type": "library",
    "license": "MIT",
    "keywords": ["onemax", "api", "client", "membership", "baku"],
    "homepage": "https://onemax.az",
    "authors": [
        {
            "name": "OneMax",
            "homepage": "https://onemax.az"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OneMax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OneMax\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    }
}
